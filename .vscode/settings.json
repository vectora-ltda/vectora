{
  "editor.fontSize": 14,
  "editor.lineHeight": 1.6,
  "editor.fontLigatures": true,
  "editor.hideCursorInOverviewRuler": true,
  "explorer.sortOrder": "foldersNestsFiles",
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": ".eslint*, eslint.config.*, prettier*, tsconfig*, vite*, pnpm-*, bun.lockb, nest*, package-lock*, bun.lock*, bunfig.toml*, components.json*, next-env.d.ts*, .mjs*, .json*, .lock*",
    "tailwind.config.*": "tailwind.config*, postcss.config*",
    ".env": ".env*",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*"
  },
  "chat.agent.enabled": false,
  "files.associations": {
    ".sequelizerc": "javascript",
    ".stylelintrc": "json",
    "*.tsx": "typescriptreact",
    ".env.*": "dotenv",
    ".prettierrc": "json"
  },
  "workbench.iconTheme": "symbols",
  "symbols.folders.associations": {
    ".github": "github",
    ".vscode": "folder-vscode"
  },
  "symbols.files.associations": {
    "*.module.ts": "nest",
    "*.guard.ts": "typescript",
    "*.spec.ts": "ts-test",
    "*.e2e-spec.ts": "ts-test",
    "*.mock.ts": "ts-test",
    "vitest.config.e2e.ts": "vite",
    ".env.development.local": "gear",
    ".env.test.local": "gear",
    ".env.local": "gear",
    ".env.sst": "gear",
    ".env.example": "gear",
    "*.ndjson": "brackets-orange",
    "docker-compose.yml": "docker-pink",
    "docker-compose.traefik.yml": "docker-pink",
    "docker-compose.paperclip.yml": "docker-pink"
  },
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "chat.commandCenter.enabled": false,
  "workbench.activityBar.location": "default",
  "workbench.editor.editorActionsLocation": "hidden",
  "editor.formatOnSave": true,
  "files.autoSave": "afterDelay",
  "editor.wordWrap": "wordWrapColumn",
  "editor.formatOnPaste": true,
  "editor.tabSize": 2,
  "files.exclude": {
    "**/node_modules": true,
    "**/LICENSE": true,
    "**/.DS_Store": true,
    "**/__pycache__": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.pytest_cache": true,
    "**/.venv": true,
    "**/venv": true,
    "**/dist": true,
    "**/build": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/.cache": true,
    "**/*.log": true,
    "**/MagicMock": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.pytest_cache": true,
    "**/dist": true,
    "**/build": true,
    "**/.next": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/.git/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/dist-electron/**": true,
    "**/dist-nuitka/**": true,
    "**/win-unpacked/**": true,
    "**/desktop/dist/**": true,
    "**/chat/dist/**": true,
    "**/.output/**": true,
    "**/htmlcov/**": true
  },
  "editor.mouseWheelZoom": true,
  "editor.autoIndentOnPaste": true,
  "explorer.confirmDelete": false,
  "editor.codeLens": false,
  "editor.comments.ignoreEmptyLines": false,
  "editor.minimap.renderCharacters": false,
  "editor.minimap.size": "fill",
  "breadcrumbs.enabled": false,
  "editor.stickyScroll.enabled": false,
  "git.openRepositoryInParentFolders": "never",
  "symbols.hidesExplorerArrows": false,
  "explorer.confirmDragAndDrop": false,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "explorer.confirmPasteNative": false,
  "security.workspace.trust.untrustedFiles": "open",
  "chat.tools.terminal.autoApprove": {
    "New-Item": true,
    "mkdir": true,
    "/^cmd /c \"mkdir src\\\\pages\\\\account 2>nul & mkdir src\\\\pages\\\\oauth 2>nul & echo done\"$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "Test-Path": true
  },
  "// prettier é a fonte de verdade (pre-commit roda prettier 3.9.5, pinado em package.json de cada subprojeto)": "Formatar no save com prettier em todos os tipos que ele controla — senão o format-on-save do editor diverge do hook e o commit fica num ping-pong de reformatação.",
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "prettier.requireConfig": true,
  "window.confirmSaveUntitledWorkspace": false,
  "geminicodeassist.project": "gen-lang-client-0946331142",
  "security.promptForLocalFileProtocolHandling": false,
  "python.languageServer": "Default",
  "python.terminal.activateEnvironment": false,
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "workbench.colorTheme": "Min Dark",
  "python-envs.defaultEnvManager": "ms-python.python:system"
}
