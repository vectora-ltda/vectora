{
  "name": "vectora-company",
  "version": "0.1.16",
  "description": "Site institucional e infra de billing da Vectora — vectora.company",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- cross-env NODE_OPTIONS=--import=./instrument.server.mjs vite dev --port 3000 --host",
    "generate-routes": "tsr generate",
    "build": "vite build && node -e \"if((process.env.NITRO_PRESET||'node-server')==='node-server'){const f=require('fs');f.mkdirSync('.output/server',{recursive:true});f.copyFileSync('instrument.server.mjs','.output/server/instrument.server.mjs')}\"",
    "preview": "vite preview",
    "typecheck": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && tsr generate && tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "prettier --write . && oxlint --fix",
    "check": "prettier --check .",
    "start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs"
  },
  "dependencies": {
    "@inlang/plugin-m-function-matcher": "^2.2.12",
    "@inlang/plugin-message-format": "^4.4.3",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@sentry/node": "^10.71.0",
    "@sentry/profiling-node": "^10.71.0",
    "@sentry/tanstackstart-react": "^10.71.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/query-db-collection": "latest",
    "@tanstack/react-db": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-store": "latest",
    "@tanstack/router-plugin": "^1.168.35",
    "@tanstack/store": "latest",
    "dotenv-cli": "^11.0.0",
    "lucide-react": "^1.34.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "satori": "^0.33.4",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-event-client": "latest",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.167.33",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.80.0",
    "prettier": "3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
