# ============================================================================
# Secrets do GitHub Actions — exemplo
# ============================================================================
# Estes NÃO são variáveis de um .env local: são "repository secrets" do GitHub.
# Cadastre cada um em: Settings → Secrets and variables → Actions → New secret
# (o nome deve bater exatamente com a chave abaixo). Os workflows os leem via
# `${{ secrets.NOME }}`. Sem o secret, o passo correspondente é pulado (deploys)
# ou usa um fallback de teste (chaves de LLM nos testes).
#
# Marcações: [obrigatório p/ X] = sem ele o job X falha;
#            [opcional] = sem ele o passo é pulado e o job ainda passa.

# ----------------------------------------------------------------------------
# Vectora (app) — testes unit/integration/e2e (.env gerado no runner)
# ----------------------------------------------------------------------------
# Provedor de LLM e chaves usadas pelos testes. Nos unit tests há fallback
# 'test-key', então são [opcional] para unit; integration/e2e precisam de chaves
# reais para exercitar LLM/rerank/web search.
GOOGLE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
COHERE_API_KEY=co-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_PROVIDER=google-genai
LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# Vectora (app) — OAuth providers
# ----------------------------------------------------------------------------
# GitHub OAuth App (Settings → Developer settings → GitHub Apps → Vectora)
GITHUB_OAUTH_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Webhook Secret (configurado no GitHub App → Webhook Secret)
# [opcional] sem ele webhooks são aceitos sem verificação de assinatura
GITHUB_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth (console.cloud.google.com → Credentials)
# [opcional] habilita Google Drive + Gmail no agente
GOOGLE_OAUTH_CLIENT_ID=xxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# GitLab OAuth (gitlab.com → Preferences → Applications)
# [opcional] habilita GitLab como alternativa ao GitHub
GITLAB_OAUTH_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITLAB_OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Slack OAuth (api.slack.com → OAuth & Permissions)
# [opcional] habilita Slack como canal de notificação e leitura
SLACK_OAUTH_CLIENT_ID=xxxxxxxxxxxx.xxxxxxxxxxxx
SLACK_OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Linear API Key (settings.linear.app/api)
# [opcional] habilita criação e listagem de issues do Linear
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxxxxxx

# Notion API Key (notion.so/my-integrations)
# [opcional] habilita leitura e criação de páginas do Notion
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Jira (id.atlassian.com/manage-profile/security/api-tokens)
# [opcional] habilita integração com Jira
JIRA_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JIRA_BASE_URL=https://minha-empresa.atlassian.net
JIRA_EMAIL=voce@empresa.com

# Webhooks de email — o usuário configura no painel do seu provider
# [opcional] habilita recebimento de eventos de email no Vectora
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_WEBHOOK_KEY=MFkwEwYHKoZIzj0CAQY...chave-publica-ecdsa-base64...
MAILGUN_WEBHOOK_SIGNING_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----------------------------------------------------------------------------
# ngrok — túnel público para webhooks em desenvolvimento local
# ----------------------------------------------------------------------------
# Sem este token o ngrok funciona, mas com limitações (URL temporária por sessão,
# 1 processo simultâneo, 40 req/min). Com token, URL estável e sem limite de req.
# Obtenha em: dashboard.ngrok.com/get-started/your-authtoken
# [opcional — sem ele o túnel sobe no modo free]
NGROK_AUTHTOKEN=xxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----------------------------------------------------------------------------
# Vectora (app) — release nativo (tags v* / workflow_dispatch)
# ----------------------------------------------------------------------------
# Assinatura do instalador Windows (.exe/.msi). CSC_LINK recebe o .pfx em base64.
# [obrigatório p/ release Windows assinado]
WIN_CERTIFICATE_BASE64=MIIKxAIBAzCCCoAGCSqGSIb3DQEH...base64-do-pfx...
WIN_CERTIFICATE_PASSWORD=senha-do-certificado-pfx

# Notarização macOS (.dmg). [obrigatório p/ release macOS notarizado]
APPLE_ID=voce@exemplo.com
APPLE_APP_SPECIFIC_PASSWORD=abcd-efgh-ijkl-mnop
APPLE_TEAM_ID=A1B2C3D4E5

# Token p/ publicar os instaladores nas releases privadas (repo vectora-releases).
# [obrigatório p/ publicar release] — PAT com escopo de repo no repositório de releases.
VECTORA_RELEASES_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----------------------------------------------------------------------------
# update-server (Cloudflare Worker) — deploy via wrangler
# ----------------------------------------------------------------------------
# [opcional] sem eles o deploy é pulado; o job Verify ainda roda.
CLOUDFLARE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_ACCOUNT_ID=0123456789abcdef0123456789abcdef
