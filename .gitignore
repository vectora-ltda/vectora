# ============================================================================
# Vectora Specific - Roaming Configuration & Data
# ============================================================================
# ~/.vectora/ is the roaming folder for user state (databases, logs, keys)
# It should NEVER be committed to the repository
data/
# ...exceto o data/ vendorizado do tema Hugo (docs/_vendor/.../data/icons.yaml)
# — sem exclusão nenhum ícone do Hextra renderiza, "data/" (sem barra
# inicial) casa em qualquer profundidade, não só na raiz do roaming folder.
!docs/_vendor/**/data/
!docs/_vendor/**/data/**
.src/
.vectora/

# AI assistant configuration directories
# These may contain API keys, conversation history, or local session data
.claude/
.anthropic/

# Local environment overrides (secrets, API keys) - NEVER COMMIT
.env
.env.local

