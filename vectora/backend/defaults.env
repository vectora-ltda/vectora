LLM_PROVIDER=google-genai
LLM_TEMPERATURE=0.2
ENABLE_WEB_SEARCH=true
ENABLE_WEB_FETCH=true
ENABLE_FILE_OPERATIONS=true
ENABLE_MCP=true
RAG_SEARCH_TOP_K=10
RAG_SEARCH_MIN_SCORE=0.5
RERANKER_TYPE=cohere
RERANKER_MODEL=rerank-multilingual-v3.0
RAG_RERANKER_TOP_K=5
LOG_LEVEL=INFO
LOG_JSON=false

# MCP Configuration
MCP_TRANSPORT_TYPE=stdio
MCP_COMMAND=uv
MCP_COMMAND_ARGS=["run", "vectora-mcp"]

# Infra local (espelha deploy/compose.dev.yml e `vectora storage up`).
# Todos os serviços exigem credencial mesmo em dev (senha na URL / API key)
# e o compose publica as portas apenas em 127.0.0.1.
# Fallbacks seguros: Postgres/Qdrant só são usados com STORAGE_MODE=complete;
# Redis passa por probe de conectividade (kv.redis_reachable) antes de ativar.
POSTGRES_DSN=postgresql+asyncpg://vectora:vectora@localhost:5432/vectora
REDIS_URL=redis://:vectora@localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=vectora

# Gateway (services/src/gateway) — fixo por produto, igual em toda
# instalação; o mesmo valor precisa estar configurado no Worker via
# `wrangler secret put VECTORA_APP_SECRET` (nunca por-usuário/por-máquina).
VECTORA_APP_SECRET=47b76ead448d7fbfc13a0ed0bb58bc16cc2232d3ebc0e016f69af9f578603298
VECTORA_OAUTH_BROKER_URL=https://services.vectora.company
