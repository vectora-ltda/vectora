{
  "name": "vectora",
  "version": "0.3.0",
  "description": "Vectora — AI-first development assistant",
  "author": "Vectora Ltda <contato@vectora.company>",
  "homepage": "https://vectora.company",
  "private": true,
  "type": "commonjs",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./lib/paraglide",
    "lint:i18n": "tsx scripts/lint-i18n.ts",
    "typecheck": "pnpm i18n:compile && tsr generate && tsc --noEmit",
    "lint:oxc": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "electron:build": "tsc -p electron/tsconfig.json",
    "electron:typecheck": "tsc -p electron/tsconfig.json --noEmit",
    "electron:start": "electron electron/dist/main.js",
    "electron:dist": "pnpm electron:build && electron-builder --config electron/electron-builder.yml",
    "electron:dist:win": "pnpm electron:build && electron-builder --config electron/electron-builder.yml --win",
    "electron:dist:mac": "pnpm electron:build && electron-builder --config electron/electron-builder.yml --mac",
    "electron:dist:linux": "pnpm electron:build && electron-builder --config electron/electron-builder.yml --linux"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@radix-ui/react-accordion": "^1.2.21",
    "@react-symbols/icons": "^1.4.1",
    "@sentry/electron": "^8.1.0",
    "electron-updater": "^6.8.9",
    "jsonc-parser": "3.3.1",
    "reagraph": "^4.32.0",
    "tree-kill": "^1.2.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.7",
    "@inlang/paraglide-js": "^2.26.0",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.64.0",
    "@radix-ui/react-avatar": "1.2.7",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-hover-card": "^1.1.24",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-separator": "1.1.16",
    "@radix-ui/react-slider": "1.5.0",
    "@radix-ui/react-slot": "1.4.0",
    "@radix-ui/react-switch": "1.3.8",
    "@radix-ui/react-tabs": "1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-virtual": "^3.14.13",
    "@tanstack/router-cli": "^1.167.40",
    "@tanstack/router-plugin": "^1.168.42",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "immer": "^11.1.21",
    "jsdom": "^30.1.2",
    "lucide-react": "^1.53.0",
    "monaco-editor": "^0.57.0",
    "motion": "^14.0.0",
    "next-themes": "^0.4.6",
    "oxlint": "^1.87.0",
    "pdfjs-dist": "^6.4.299",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-rnd": "^10.5.3",
    "react-syntax-highlighter": "^16.1.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1",
    "zod": "4.6.5",
    "zustand": "^5.0.15"
  }
}
