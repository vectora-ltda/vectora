# Política do Snyk. Cada ignore é por regra e por arquivo, com motivo e prazo
# para ser revisto; nada é ignorado por diretório inteiro.
version: v1.25.0
ignore:
  python/PT:
    - 'backend/api/handlers/backup.py':
        reason: Arquivo de backup escolhido no diálogo nativo; a rota exige a ponte do desktop.
        expires: 2027-05-05T00:00:00.000Z
    - 'backend/api/handlers/chat.py':
        reason: O diretório vem de workspace registrado e autorizado pelas safe roots.
        expires: 2027-05-05T00:00:00.000Z
    - 'backend/api/handlers/memory_buckets.py':
        reason: O bucket_id é validado por _validate_bucket_id antes de montar qualquer caminho.
        expires: 2027-05-05T00:00:00.000Z
    - 'backend/api/handlers/skills.py':
        reason: O alvo vem de workspace autorizado ou de identificador de runtime validado por regex.
        expires: 2027-05-05T00:00:00.000Z
    - 'backend/api/handlers/threads.py':
        reason: O caminho vem do índice interno de assets, não da requisição.
        expires: 2027-05-05T00:00:00.000Z
    - 'backend/api/handlers/workspaces.py':
        reason: Caminhos confinados ao workspace por resolve_within_workspace e pastas autorizadas pelas safe roots.
        expires: 2027-05-05T00:00:00.000Z
  python/CommandInjection:
    - 'backend/api/handlers/chat.py':
        reason: Servidores MCP stdio são configurados pelo usuário e exigem confirmação de confiança.
        expires: 2027-05-05T00:00:00.000Z
    - 'backend/api/handlers/provider_routing.py':
        reason: O llama-server vem do diretório de runtime gerenciado; modelo e opções são validados em start_llamacpp.
        expires: 2027-05-05T00:00:00.000Z
    - 'backend/api/handlers/workspaces.py':
        reason: gh recebe argv sem shell com entradas validadas; launch.json só roda em workspace confiável.
        expires: 2027-05-05T00:00:00.000Z
patch: {}
