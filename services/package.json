{
  "name": "vectora-services",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "description": "Cloudflare Worker único: gateway (OAuth/webhooks pro desktop, ex-relay) + updates (distribuição de releases) + auth/billing/license/gdpr/memory-buckets/registry (próximas fases).",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "release": "tsx scripts/release.ts",
