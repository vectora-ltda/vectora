LLM_PROVIDER=google-genai
GOOGLE_API_KEY=
TAVILY_API_KEY=
COHERE_API_KEY=

# Opcional: LLM providers alternativos
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Storage mode ────────────────────────────────────────────────────────────
# lite     = SQLite + LanceDB (padrão, zero dependências externas)
# complete = PostgreSQL + Qdrant + Redis  →  iniciar com:
#            docker compose -f deploy/compose.dev.yml up -d
STORAGE_MODE=lite

# PostgreSQL (apenas STORAGE_MODE=complete)
POSTGRES_DSN=postgresql+asyncpg://vectora:vectora@localhost:5432/vectora

# Redis (apenas STORAGE_MODE=complete)
REDIS_URL=redis://localhost:6379/0

# Qdrant (apenas STORAGE_MODE=complete)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ─── Docker / VPS ────────────────────────────────────────────────────────────
# Senhas dos serviços em produção (compose.complete.yml)
POSTGRES_USER=vectora
POSTGRES_PASSWORD=
POSTGRES_DB=vectora
REDIS_PASSWORD=

# Traefik (apenas se usar docker-compose.traefik.yml)
VECTORA_DOMAIN=vectora.seudominio.com
ACME_EMAIL=seuemail@exemplo.com

# ─── Licença / auth (services.vectora.company) ──────────────────────────────
# VECTORA_TOKEN: token de licença Pro (obtido em vectora.company/dashboard ou
# via `POST /license/connect` com email+senha). Ausente = Free.
VECTORA_TOKEN=

# VECTORA_OAUTH_SECRET: mesmo valor cadastrado em services/ via
# `wrangler secret put VECTORA_OAUTH_SECRET` — autentica o polling do gateway
# no fluxo de OAuth device-flow (`POST /license/oauth/init` +
# `GET /license/oauth/poll`).
VECTORA_OAUTH_SECRET=

# Overrides opcionais — os defaults já apontam para services.vectora.company
# e gateway.vectora.chat em produção; só mude para apontar a um services local
# (`wrangler dev`) ou self-hosted.
# VECTORA_LICENSE_URL=https://services.vectora.company/license/validate
# VECTORA_LICENSE_CONNECT_URL=https://services.vectora.company/license/agent-login
# VECTORA_LICENSE_PORTAL_URL=https://services.vectora.company/license/portal
# VECTORA_COMPANY_URL=https://vectora.company
# VECTORA_GATEWAY_URL=https://gateway.vectora.chat

# VECTORA_APP_SECRET: usado pelo GatewayClient pra autenticar POST /register
# no Worker do gateway. Fixo por produto (default em backend/settings.py,
# igual em toda instalação — o mesmo valor precisa estar configurado no
# Worker via `wrangler secret put VECTORA_APP_SECRET`). Só defina aqui pra
# apontar a um Worker self-hosted com secret próprio.
# VECTORA_APP_SECRET=

# Pula a validação remota de licença (dev/CI apenas — nunca em produção).
# VECTORA_LICENSE_BYPASS=1

# ─── Sessão web do chat (auth local, independente do services) ──────────────
# VECTORA_ACCESS_TOKEN_MINUTES=15
# VECTORA_REFRESH_TOKEN_DAYS=7
# VECTORA_AUTH_REQUIRED=true

# Provider de secrets locais (keepass é o default multiplataforma)
# VECTORA_SECRETS_PROVIDER=keepass

# ─── Integrações OAuth (aba Ambiente → Integrações) ──────────────────────────
# Sem essas envs, "Conectar via OAuth" fica escondido na UI (só o token
# manual aparece) — GET /integrations reporta oauth_configured=false.
# Callback (Authorization callback URL) a apontar em cada cadastro:
# em produção/gateway conectado, https://gateway.vectora.chat/auth/{provider}/callback
# (o Worker resolve pro subdomínio {token}.vectora.chat da instância —
# ver backend/api/handlers/oauth.py::_gateway_callback_url); sem gateway,
# http://localhost:8080/auth/{provider}/callback.

# GitHub — cadastre um GitHub App (não OAuth App clássico, deprecado pelo
# GitHub pra integrações novas): https://github.com/settings/apps/new
# Marque "Request user authorization (OAuth) during installation" e
# desmarque a expiração de 8h do token de usuário em "Optional features"
# (senão o token expira e precisa de refresh, não implementado aqui).
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=

# GitLab — OAuth App clássico: https://gitlab.com/-/profile/applications
# (ou /-/profile/applications na sua instância self-hosted, ver GITLAB_BASE_URL)
# GITLAB_OAUTH_CLIENT_ID=
# GITLAB_OAUTH_CLIENT_SECRET=
# GITLAB_BASE_URL=https://gitlab.com
# GITLAB_OAUTH_REDIRECT_URI=

# Google — OAuth App clássico: https://console.cloud.google.com/apis/credentials
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=

# Slack — OAuth App clássico: https://api.slack.com/apps
# SLACK_OAUTH_CLIENT_ID=
# SLACK_OAUTH_CLIENT_SECRET=
# SLACK_OAUTH_REDIRECT_URI=
